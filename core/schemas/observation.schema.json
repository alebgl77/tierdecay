{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tierdecay.dev/schemas/observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "class", "predicted", "executed", "outcome", "escalations", "playbook", "obsId", "resourceCost", "failures", "incidentLoss", "risk", "epoch"],
  "properties": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "class": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){1,3}$" },
    "predicted": { "enum": ["T1", "T2", "T3"] },
    "executed": { "enum": ["T1", "T2", "T3"] },
    "outcome": { "type": "string", "minLength": 1 },
    "escalations": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "playbook": { "type": "string", "pattern": "^(?:PB-[1-9][0-9]*|—)$" },
    "obsId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "resourceCost": { "type": "number", "minimum": 0 },
    "failures": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "incidentLoss": { "type": "number", "minimum": 0 },
    "risk": { "type": "integer", "minimum": 0, "maximum": 3 },
    "epoch": { "type": "string", "pattern": "^\\S+$" }
  },
  "allOf": [
    { "if": { "properties": { "outcome": { "const": "pass" } } }, "then": { "properties": { "failures": { "const": 0 } } } },
    { "if": { "properties": { "outcome": { "const": "fail" } } }, "then": { "properties": { "failures": { "minimum": 1 } } } }
  ]
}
