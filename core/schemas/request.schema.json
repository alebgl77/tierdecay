{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tierdecay.dev/schemas/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["class", "risk", "critical", "recurring", "horizon", "epoch", "rubric"],
  "properties": {
    "class": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){1,3}$" },
    "risk": { "type": "integer", "minimum": 0, "maximum": 3 },
    "critical": { "type": "boolean" },
    "recurring": { "type": "boolean" },
    "horizon": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "epoch": { "type": "string", "pattern": "^\\S+$" },
    "playbook": { "type": "string", "pattern": "^PB-[1-9][0-9]*$" },
    "rubric": {
      "type": "object", "additionalProperties": false,
      "required": ["ambiguity", "reasoning", "blastRadius", "riskSurface"],
      "properties": {
        "ambiguity": { "type": "integer", "minimum": 0, "maximum": 2 },
        "reasoning": { "type": "integer", "minimum": 0, "maximum": 3 },
        "blastRadius": { "type": "integer", "minimum": 0, "maximum": 2 },
        "riskSurface": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "risk": { "const": 0 } } }, "then": { "properties": { "rubric": { "properties": { "riskSurface": { "const": 0 } } } } } },
    { "if": { "properties": { "risk": { "const": 1 } } }, "then": { "properties": { "rubric": { "properties": { "riskSurface": { "const": 1 } } } } } },
    { "if": { "properties": { "risk": { "const": 2 } } }, "then": { "properties": { "rubric": { "properties": { "riskSurface": { "const": 2 } } } } } },
    { "if": { "properties": { "risk": { "const": 3 } } }, "then": { "properties": { "rubric": { "properties": { "riskSurface": { "const": 3 } } } } } }
  ]
}
